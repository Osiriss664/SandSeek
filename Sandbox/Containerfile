# Web tool server for `sandseek`. Built and run with Apple `container`
# by Scripts/research_sandbox.sh; see docs/SECURITY.md.
#
# The base image is pinned by digest (python:3.12-slim) and every Python
# package by hash, so a rebuild installs the same code. To update, change the
# digest and regenerate requirements.txt as requirements.in describes.
# nftables comes from Debian's repositories unpinned (the VM runs the firewall,
# so the package matters); the build prints the installed versions of nftables
# and Python so a build log records them. Check the Python patch level there
# against CVE-2025-6069 (html.parser, quadratic) when the digest is updated; the
# server also runs its HTML fallback parser in a killed-after-timeout child.
FROM docker.io/library/python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements.txt /app/requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends nftables \
    && dpkg-query --show nftables && python --version \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --require-hashes --no-deps -r /app/requirements.txt \
    && useradd --uid 10001 --no-create-home --home-dir /nonexistent \
       --shell /usr/sbin/nologin sandbox

COPY server.py firewall.nft entrypoint.sh /app/

# Starts as root only to load firewall.nft; server.py then switches to user
# 10001 and drops every capability before it serves a request.
EXPOSE 9100
ENTRYPOINT ["/app/entrypoint.sh"]
